# Google OAuth credentials downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_FILE=~/.config/budget/credentials.json

# Auto-generated after first OAuth flow
GOOGLE_TOKEN_FILE=~/.config/budget/token.json

# The ID from the Google Sheets URL: docs.google.com/spreadsheets/d/<ID>/edit
BUDGET_SPREADSHEET_ID=your_spreadsheet_id_here

# How many days back to search Gmail for bank notification emails
GMAIL_LOOKBACK_DAYS=7

# Deduplication window in days for fuzzy matching
DEDUP_WINDOW_DAYS=3

# Your local timezone
DEFAULT_TIMEZONE=America/New_York
